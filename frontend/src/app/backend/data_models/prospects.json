{
    "title": "prospects",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "user_id": {
            "type": "string",
            "description": "User ID of the assigned commercial"
        },
        "nom_societe": {
            "type": "string",
            "description": "Company name"
        },
        "nom_dirigeant": {
            "type": "string",
            "description": "Director name"
        },
        "telephone": {
            "type": "string",
            "description": "Phone number"
        },
        "email": {
            "type": "string",
            "description": "Email address"
        },
        "zone_geographique": {
            "type": "string",
            "description": "Geographic zone"
        },
        "categorie_metier": {
            "type": "string",
            "description": "Business category"
        },
        "commercial_assigne": {
            "type": "string",
            "description": "Assigned commercial name"
        },
        "statut_avancement": {
            "type": "string",
            "description": "Current sales cycle status",
            "default": "Appel téléphonique"
        },
        "date_dernier_appel": {
            "type": "string",
            "format": "date-time",
            "description": "Last call date"
        },
        "date_prochaine_relance": {
            "type": "string",
            "format": "date-time",
            "description": "Next follow-up date"
        },
        "nombre_appels": {
            "type": "integer",
            "description": "Total number of calls",
            "default": 0
        },
        "nombre_relances": {
            "type": "integer",
            "description": "Total number of follow-ups",
            "default": 0
        },
        "date_visio": {
            "type": "string",
            "format": "date-time",
            "description": "Video call date"
        },
        "date_demande_documents": {
            "type": "string",
            "format": "date-time",
            "description": "Document request date"
        },
        "date_signature": {
            "type": "string",
            "format": "date-time",
            "description": "Signature date"
        },
        "notes": {
            "type": "string",
            "description": "Commercial notes"
        },
        "priorite": {
            "type": "string",
            "description": "Priority level: haute, moyenne, basse",
            "default": "moyenne"
        },
        "source_lead": {
            "type": "string",
            "description": "Lead source"
        },
        "montant_potentiel": {
            "type": "number",
            "description": "Potential deal amount",
            "default": 0
        },
        "statut_gagne_perdu": {
            "type": "string",
            "description": "Won/Lost status: actif, gagne, perdu",
            "default": "actif"
        },
        "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation date"
        },
        "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update date"
        }
    },
    "required": [
        "id",
        "user_id",
        "nom_societe"
    ]
}